{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "default",
  "description": "DSH Desktop 主窗口权限（含 dsh web 远程域的 IPC 访问）",
  "windows": ["main"],
  "remote": {
    "urls": [
      "http://127.0.0.1:3080",
      "http://localhost:3080",
      "http://127.0.0.1:*",
      "http://localhost:*"
    ]
  },
  "permissions": [
    "core:default",
    "notification:default",
    "opener:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:webview:default",
    "core:event:default",
    "core:app:default"
  ]
}
